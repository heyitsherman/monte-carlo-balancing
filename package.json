{
  "name": "monte-carlo-balancing",
  "private": true,
  "version": "1.0.0",
  "description": "Presenter-driven demo: Monte Carlo simulation as a game-balancing tool.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --mode single && node scripts/offline.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "calibrate": "vite-node scripts/calibrate.ts",
    "bench": "vite-node scripts/benchmark.ts"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vite": "^6.0.7",
    "vite-node": "^3.2.4",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^3.2.7"
  }
}
